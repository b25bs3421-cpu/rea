{
  "name": "reelix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REELIX \u2014 an original, full-stack streaming experience reverse engineered from the UX patterns of modern subscription video apps.",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "vite build && APP_ENV=production node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "art": "tsx scripts/generate-art.tsx",
    "smoke": "tsx scripts/smoke.tsx"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
